# The Lenny Growth Assistant — backend configuration
# Copy to .env and edit. .env is gitignored; this file must never hold a real secret.

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
DEFAULT_LLM_PROVIDER=cloud

# --- Cloud provider (Anthropic) -----------------------------------------
# Absent => Cloud mode reports unavailable and the app still runs in Local mode.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
ANTHROPIC_ROUTER_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096
CLOUD_TIMEOUT_SECONDS=120

# --- Local provider (Ollama) --------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_FIRST_TOKEN_TIMEOUT=90
OLLAMA_IDLE_TIMEOUT=120

# --- Retrieval ----------------------------------------------------------
# EMBED_SPACE=voyage requires VOYAGE_API_KEY, or the app refuses to start.
EMBED_SPACE=local
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# Context window. Ollama defaults to 4096 and silently truncates longer
# prompts, which would cut retrieved transcripts out of the local path.
#
# 8192, not 16384: the local path now retrieves four excerpts rather than eight
# (see LOCAL_SKILL_CONFIG), which measured at ~3,050 input tokens, so 16K was
# allocating a KV cache twice the size of anything that could occupy it. On an
# 8 GB machine that allocation is the difference between a model that loads and
# one that does not. Raise it if you switch to a larger model AND have the RAM.
OLLAMA_NUM_CTX=8192
